# ============================================================
# Holy Grail Bot — Polymarket Trading Engine Configuration
# ============================================================

# Target pair cost for arbitrage (e.g. 0.99 means buy if Yes + No < $0.99)
TARGET_PAIR_COST=0.99
ORDER_SIZE=5.0
MIN_LIQUIDITY=50.0

# Order Type: FOK (Fill or Kill), FAK (Fill and Kill), GTC (Good Till Cancel)
ORDER_TYPE=FAK

# Simulation Mode (true = paper trading, false = real trades)
DRY_RUN=true
VERBOSE=false
SIM_BALANCE=100.0
COOLDOWN_SECONDS=10

# WebSocket Ingestion
USE_WSS=true
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
USE_PROXY=false

# Polymarket Web3 Credentials
# (API credentials are automatically derived from private key at startup)
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here
POLYMARKET_SIGNATURE_TYPE=0
